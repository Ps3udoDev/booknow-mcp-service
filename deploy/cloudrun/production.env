# Non-secret values for the production service. Secrets live in Secret Manager; only their names go here.
# <...> placeholders are filled once the GCP project exists (docs/runbook-cloud-run.md, "Preparación única").
PROJECT_ID=<gcp-project-id>
PROJECT_NUMBER=<gcp-project-number>
REGION=us-west1
SERVICE=booknow-mcp
APP_ENV=production
LOG_LEVEL=info
RUNTIME_SA=booknow-mcp-runtime@<gcp-project-id>.iam.gserviceaccount.com
SUPABASE_URL=https://rrnysepngbycvuciodoj.supabase.co
# Replace with the custom domain once it is mapped (it is also the OAuth protected resource).
MCP_PUBLIC_URL=https://booknow-mcp-<gcp-project-number>.us-west1.run.app
# Browser origins allowed to call /mcp (comma-separated, no "*"). Empty = none: native and server-side
# clients send no Origin and are unaffected. Add an origin only after seeing a real client send it.
MCP_ALLOWED_ORIGINS=
MAX_INSTANCES=3
DB_MAX_CONNS=4
DATABASE_URL_SECRET=booknow-mcp-database-url
DATABASE_URL_SECRET_VERSION=1
