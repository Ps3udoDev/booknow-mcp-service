# Non-secret values for the staging service. Secrets live in Secret Manager; only their names go here.
# <...> placeholders are filled once the GCP project exists (docs/runbook-cloud-run.md, "Preparación única").
PROJECT_ID=<gcp-project-id>
PROJECT_NUMBER=<gcp-project-number>
REGION=us-west1
SERVICE=booknow-mcp-staging
APP_ENV=staging
LOG_LEVEL=info
RUNTIME_SA=booknow-mcp-runtime@<gcp-project-id>.iam.gserviceaccount.com
SUPABASE_URL=https://rrnysepngbycvuciodoj.supabase.co
# Deterministic Cloud Run URL: https://<service>-<project-number>.<region>.run.app
MCP_PUBLIC_URL=https://booknow-mcp-staging-<gcp-project-number>.us-west1.run.app
# Outside development every origin must be https, so the local MCP Inspector (http://localhost:6274) cannot be
# allowed here: use its proxy mode, which sends no browser Origin.
MCP_ALLOWED_ORIGINS=
# Staging + production share the Session Pooler: 1×2 + 3×4 = 14 connections (see the runbook).
MAX_INSTANCES=1
DB_MAX_CONNS=2
DATABASE_URL_SECRET=booknow-mcp-staging-database-url
DATABASE_URL_SECRET_VERSION=1
