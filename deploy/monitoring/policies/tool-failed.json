{
  "displayName": "booknow-mcp: tools MCP con error interno",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "más de 3 tools con error interno en 5 min",
      "conditionThreshold": {
        "filter": "resource.type = \"cloud_run_revision\" AND resource.labels.service_name = \"${SERVICE}\" AND metric.type = \"logging.googleapis.com/user/booknow_mcp_tool_failed\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 3,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "${CHANNEL}"
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "documentation": {
    "mimeType": "text/markdown",
    "content": "Tools MCP que fallan con `INTERNAL`. El log `mcp tool failed` indica la tool y el error.\n\nRunbook: docs/runbook-cloud-run.md (Observabilidad y Revertir)."
  }
}
