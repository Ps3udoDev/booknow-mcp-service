# Copia a .env para desarrollo local. En Cloud Run los secretos vienen de Secret Manager.
# Nunca pongas valores reales en este archivo.

# ---------- Runtime ----------
PORT=8080
APP_ENV=development          # development | staging | production
LOG_LEVEL=info               # debug | info | warn | error

# ---------- Supabase ----------
SUPABASE_URL=https://<project-ref>.supabase.co
# Session Pooler si Cloud Run no tiene IPv6 (ver migracion/docs/guia-go-cloud-run-supabase.md §2)
# Rol de mínimo privilegio booknow_mcp_service (nunca postgres). Con el pooler el usuario lleva el ref: <rol>.<project-ref>
DATABASE_URL=postgres://booknow_mcp_service.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_MAX_CONNS=5
# Emisor (<SUPABASE_URL>/auth/v1) y JWKS (<emisor>/.well-known/jwks.json) se derivan de SUPABASE_URL.
# Solo origen, sin ruta. En development se permite http://127.0.0.1:54321 (Supabase local).
SUPABASE_JWT_AUDIENCE=authenticated

# ---------- MCP & OAuth ----------
# Origen público del servicio (sin ruta). Recurso MCP = <MCP_PUBLIC_URL>/mcp. https fuera de development.
# El issuer OAuth publicado en /.well-known/oauth-protected-resource se deriva de SUPABASE_URL.
MCP_PUBLIC_URL=http://localhost:8080
# Orígenes de navegador permitidos en /mcp, separados por comas (sin "*"). Los clientes sin Origin no se ven afectados.
# http://localhost:6274 = MCP Inspector en local.
MCP_ALLOWED_ORIGINS=http://localhost:6274
# Minutos que un borrador de cita espera la aprobación del usuario (1-60). El horario no queda reservado mientras tanto.
MCP_DRAFT_TTL_MINUTES=10
# Tool calls por minuto y conexión, en memoria por instancia (1-10000).
MCP_RATE_LIMIT_PER_MINUTE=60
# Sin variables para roles ni retención: los roles (owner, admin, manager) están fijos en código (D6) y la retención
# de auditoría (7–90 días por negocio) la aplica purge_mcp_tool_calls() en Supabase (D11).

# ---------- Twilio WhatsApp (Fase 7) ----------
# Token de la cuenta de Twilio (SECRETO: Secret Manager en Cloud Run). Firma y valida los webhooks.
# Va junto con TWILIO_WEBHOOK_URL y TWILIO_ACCOUNT_SID: si falta alguna, el arranque falla; si faltan token y URL, el webhook no se sirve.
TWILIO_AUTH_TOKEN=
# URL pública del webhook, exactamente como está configurada en la consola de Twilio: forma parte de la firma.
TWILIO_WEBHOOK_URL=http://localhost:8080/webhooks/twilio
# Cuenta de Twilio (no es secreto). Obligatoria con el webhook: se rechaza cualquier webhook de otra cuenta.
TWILIO_ACCOUNT_SID=
# Envío de mensajes (pendiente, tarea 7.7).
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
FROM_EMAIL=
